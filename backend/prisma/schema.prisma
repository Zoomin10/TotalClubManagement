generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConsentForm {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ageGroup        String
  wwfcTeam        String?
  playerFirstName String
  playerSurname   String
  playerDob       DateTime
  playerSex       String

  emergencyContact1 Json
  emergencyContact2 Json

  postcode    String
  houseNumber String
  email       String

  medicalInfo String
  allergies   String?

  photoUrl String?

  consentData     Boolean
  consentPhotos   Boolean
  consentVideos   Boolean
  consentWalkHome Boolean?

  parentSignature String
  parentName      String
  signatureDate   DateTime

  stripeScheduleId String? @unique

  // Membership payment plan
  paymentPlan        PaymentPlan?
  monthlyAmountPence Int?
  firstPaymentDate   DateTime?

  // Stripe references
  stripeCustomerId        String?
  stripeSubscriptionId    String? @unique
  stripeCheckoutSessionId String? @unique

  // Subscription state; separate from successful payment history
  stripeSubscriptionStatus String?
  seasonMemberships        SeasonMembership[]
  invoices                 MembershipInvoice[]
}

model MembershipInvoice {
  seasonMembershipId String?
  seasonMembership   SeasonMembership? @relation(fields: [seasonMembershipId], references: [id], onDelete: Restrict)
  id                 String            @id @default(cuid())
  registrationId     String
  registration       ConsentForm       @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  stripeInvoiceId      String  @unique
  stripeSubscriptionId String
  invoiceNumber        String?

  currency             String
  amountDuePence       Int
  amountPaidPence      Int
  amountRemainingPence Int

  // Stripe invoice status: draft, open, paid, void, uncollectible.
  // A failed payment can leave the invoice open.
  status               String
  attemptCount         Int       @default(0)
  lastPaymentFailedAt  DateTime?
  nextPaymentAttemptAt DateTime?

  invoiceCreatedAt DateTime
  paidAt           DateTime?
  hostedInvoiceUrl String?
  invoicePdfUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId, invoiceCreatedAt])
}

enum PaymentPlan {
  MATCHES_AND_TRAINING
  TRAINING_ONLY
}

model ClubVolunteer {
  id                       String                @id @default(cuid())
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  firstName                String
  lastName                 String
  email                    String                @unique
  phone                    String
  team                     String?
  requestedRoles           Json
  assignedRoles            Json
  applicationPermissions   String[]              @default([])
  accessRole               String                @default("NONE")
  status                   String                @default("AWAITING_REVIEW")
  notes                    String                @default("")
  acceptanceTokenHash      String?               @unique
  acceptanceTokenExpiresAt DateTime?
  acceptances              VolunteerAcceptance[]
  changes                  VolunteerChange[]
}

model VolunteerAcceptance {
  id          String        @id @default(cuid())
  volunteerId String
  volunteer   ClubVolunteer @relation(fields: [volunteerId], references: [id], onDelete: Restrict)
  agreement   String
  version     String
  content     String
  acceptedAt  DateTime      @default(now())

  @@unique([volunteerId, agreement, version])
}

model VolunteerChange {
  id          String        @id @default(cuid())
  volunteerId String
  volunteer   ClubVolunteer @relation(fields: [volunteerId], references: [id], onDelete: Restrict)
  actor       String
  action      String
  details     Json
  createdAt   DateTime      @default(now())

  @@index([volunteerId, createdAt])
}

model SocialMediaPost {
  id        String   @id @default(cuid())
  url       String   @unique
  platform  String
  title     String
  createdBy String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Metadata only; never store exported medical values or the CSV here.
model ReportExportAudit {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actor       String
  report      String
  recordCount Int

  @@index([createdAt])
}

model ClubSeason {
  id           String             @id @default(cuid())
  startYear    Int                @unique
  label        String
  startsAt     DateTime
  endsAt       DateTime
  status       String             @default("DRAFT")
  termsVersion String
  termsContent String
  createdAt    DateTime           @default(now())
  plans        SeasonPlan[]
  memberships  SeasonMembership[]
}

model SeasonPlan {
  id            String      @id @default(cuid())
  seasonId      String
  season        ClubSeason  @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  paymentPlan   PaymentPlan
  amountPence   Int
  stripePriceId String

  @@unique([seasonId, paymentPlan])
}

model SeasonMembership {
  id                      String              @id @default(cuid())
  registrationId          String
  registration            ConsentForm         @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  seasonId                String
  season                  ClubSeason          @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  paymentPlan             PaymentPlan?
  amountPence             Int?
  stripePriceId           String?
  state                   String              @default("OFFERED")
  origin                  String              @default("RENEWAL")
  firstPaymentDate        DateTime?
  acceptedAt              DateTime?
  acceptedBy              String?
  termsVersion            String?
  termsContent            String?
  permissions             Json?
  medicalConsent          Boolean             @default(false)
  leftAt                  DateTime?
  stripeScheduleId        String?             @unique
  stripeSubscriptionId    String?             @unique
  stripeCheckoutSessionId String?             @unique
  billingStatus           String?
  tokenHash               String?             @unique
  tokenExpiresAt          DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  invoices                MembershipInvoice[]

  @@unique([registrationId, seasonId])
}

model SeasonChange {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  actor          String
  action         String
  seasonId       String?
  registrationId String?
  details        Json

  @@index([createdAt])
}
