+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const service = require("../backend/src/services/retentionReview");
+const now = new Date("2026-10-15T12:00:00Z");
+function record() {
+  return {
+    id: "member",
+    createdAt: new Date("2025-07-01"),
+    playerFirstName: "Archive",
+    playerSurname: "Fixture",
+    wwfcTeam: "Test",
+    archivedAt: null,
+    archiveReviewAt: null,
+    retentionHoldAt: null,
+    stripeCustomerId: null,
+    _count: { invoices: 0 },
+    seasonMemberships: [
+      {
+        id: "membership",
+        state: "ACCEPTED",
+        origin: "NEW_REGISTRATION",
+        acceptedAt: new Date("2025-07-01"),
+        firstPaymentDate: new Date("2025-08-01"),
+        season: {
+          id: "season",
+          label: "2025 / 26",
+          startsAt: new Date("2025-06-01"),
+          endsAt: new Date("2026-06-01"),
+        },
+      },
+    ],
+  };
+}
+function dbFor(original) {
+  const state = {
+    record: structuredClone(original),
+    audit: [],
+    tokensValid: true,
+  };
+  const db = {
+    consentForm: {
+      findUnique: async () => structuredClone(state.record),
+      updateMany: async ({ where, data }) => {
+        if (where.archivedAt?.not === null && !state.record.archivedAt)
+          return { count: 0 };
+        if (where.archivedAt === null && state.record.archivedAt)
+          return { count: 0 };
+        Object.assign(state.record, data);
+        return { count: 1 };
+      },
+    },
+    seasonMembership: {
+      updateMany: async () => {
+        state.tokensValid = false;
+        return { count: 1 };
+      },
+    },
+    memberRetentionAudit: {
+      create: async (q) => {
+        state.audit.push(q.data);
+      },
+    },
+  };
+  db.$transaction = async (fn) => {
+    const before = structuredClone(state);
+    try {
+      return await fn(db);
+    } catch (e) {
+      Object.assign(state, before);
+      throw e;
+    }
+  };
+  return { db, state };
+}
+const input = {
+  reason: "Season ended; non-renewal confirmed",
+  reviewDate: "2027-05-31",
+};
+test("real season membership overrides a newer original registration estimate", () => {
+  const r = record();
+  r.createdAt = new Date("2026-10-01");
+  const m = service.reviewRecord(r, now);
+  assert.equal(m.confirmedSeason, "2025 / 26");
+  assert.equal(m.seasonEnd, "2026-05-31");
+  assert.equal(m.archiveEligible, true);
+  assert.equal(m.deletionEligible, false);
+});
+test("registration date alone never authorises archive", () => {
+  const r = record();
+  r.seasonMemberships = [];
+  assert.equal(service.reviewRecord(r, now).archiveEligible, false);
+});
+test("current-season member and midseason leaver are retained until May ends", () => {
+  for (const state of ["ACCEPTED", "LEFT"]) {
+    const r = record();
+    const m = r.seasonMemberships[0];
+    m.season.startsAt = new Date("2026-06-01");
+    m.season.endsAt = new Date("2027-06-01");
+    m.state = state;
+    m.leftAt = state === "LEFT" ? new Date("2026-09-01") : null;
+    assert.equal(service.reviewRecord(r, now).archiveEligible, false);
+  }
+});
+test("future accepted renewal prevents archiving an old season", () => {
+  const r = record();
+  r.seasonMemberships.push({
+    state: "ACCEPTED",
+    acceptedAt: now,
+    season: {
+      id: "next",
+      label: "2027 / 28",
+      startsAt: new Date("2027-06-01"),
+      endsAt: new Date("2028-06-01"),
+    },
+  });
+  assert.equal(service.reviewRecord(r, now).archiveEligible, false);
+});
+test("a cancelled renewal before it starts does not extend actual membership", () => {
+  const r = record();
+  r.seasonMemberships.push({
+    state: "LEFT",
+    acceptedAt: now,
+    leftAt: now,
+    season: {
+      id: "next",
+      label: "2027 / 28",
+      startsAt: new Date("2027-06-01"),
+      endsAt: new Date("2028-06-01"),
+    },
+  });
+  assert.equal(service.reviewRecord(r, now).confirmedSeason, "2025 / 26");
+  assert.equal(service.reviewRecord(r, now).archiveEligible, true);
+});
+test("unaccepted offered renewal marked left is not proof of a season", () => {
+  const r = record();
+  r.seasonMemberships = [
+    {
+      state: "LEFT",
+      origin: "RENEWAL",
+      leftAt: now,
+      season: {
+        label: "2025 / 26",
+        startsAt: new Date("2025-06-01"),
+        endsAt: new Date("2026-06-01"),
+      },
+    },
+  ];
+  assert.equal(service.reviewRecord(r, now).archiveEligible, false);
+});
+test("open invoices block archiving", async () => {
+  const r = record();
+  r._count.invoices = 1;
+  const { db } = dbFor(r);
+  await assert.rejects(
+    service.archive(db, {}, r.id, "chair", input, now),
+    /open invoices/,
+  );
+});
+test("archive is transactional, removes token access and records metadata while preserving hold", async () => {
+  const r = record();
+  r.retentionHoldAt = now;
+  r.retentionHoldReason = "Case reference 123";
+  const { db, state } = dbFor(r);
+  await service.archive(
+    db,
+    () => {
+      throw Error("No Stripe needed");
+    },
+    r.id,
+    "chair",
+    input,
+    now,
+  );
+  assert.equal(state.record.archivedAt.toISOString(), now.toISOString());
+  assert.equal(
+    state.record.archiveReviewAt.toISOString(),
+    "2027-05-31T22:59:59.999Z",
+  );
+  assert.equal(state.tokensValid, false);
+  assert.equal(state.record.retentionHoldReason, "Case reference 123");
+  assert.equal(state.audit[0].action, "ARCHIVED");
+});
+test("audit failure rolls back archive and token invalidation", async () => {
+  const r = record();
+  const { db, state } = dbFor(r);
+  db.memberRetentionAudit.create = async () => {
+    throw Error("audit unavailable");
+  };
+  await assert.rejects(
+    service.archive(db, {}, r.id, "chair", input, now),
+    /audit unavailable/,
+  );
+  assert.equal(state.record.archivedAt, null);
+  assert.equal(state.tokensValid, true);
+});
+test("review date must be valid and in the future", async () => {
+  for (const reviewDate of ["2026-02-31", "2026-09-01"]) {
+    const r = record();
+    const { db } = dbFor(r);
+    await assert.rejects(
+      service.archive(db, {}, r.id, "chair", { ...input, reviewDate }, now),
+      /future archive review/,
+    );
+  }
+});
+test("restore preserves hold and does not restart billing or tokens", async () => {
+  const r = record();
+  r.archivedAt = now;
+  r.retentionHoldAt = now;
+  const { db, state } = dbFor(r);
+  state.tokensValid = false;
+  await service.restore(db, r.id, "chair", "Correcting archive decision");
+  assert.equal(state.record.archivedAt, null);
+  assert.ok(state.record.retentionHoldAt);
+  assert.equal(state.tokensValid, false);
+  assert.equal(state.record.stripeCustomerId, null);
+  assert.equal(state.audit[0].action, "RESTORED");
+});
+test("reviewing continued retention records a future review and leaves member archived", async () => {
+  const r = record();
+  r.archivedAt = now;
+  const { db, state } = dbFor(r);
+  await service.review(
+    db,
+    r.id,
+    "chair",
+    { ...input, reason: "Required for case reference 123" },
+    now,
+  );
+  assert.ok(state.record.archivedAt);
+  assert.equal(state.audit[0].action, "ARCHIVE_REVIEWED");
+});
+test("hold release requires an audit and preserves member record", async () => {
+  const r = record();
+  const { db, state } = dbFor(r);
+  await service.hold(db, r.id, "chair", true, "Case reference 123");
+  assert.ok(state.record.retentionHoldAt);
+  await service.hold(db, r.id, "chair", false, "Case reference 123 resolved");
+  assert.equal(state.record.retentionHoldAt, null);
+  assert.equal(state.audit.length, 2);
+});
+function stripeWith(schedules = [], subs = []) {
+  return {
+    customers: {
+      retrieve: async () => ({
+        livemode: false,
+        metadata: { registrationId: "member" },
+      }),
+    },
+    subscriptionSchedules: {
+      list: async () => ({ data: schedules, has_more: false }),
+    },
+    subscriptions: { list: async () => ({ data: subs, has_more: false }) },
+  };
+}
+test("live Stripe check rejects active schedules despite stale cancelled DB status", async () => {
+  const r = record();
+  r.stripeCustomerId = "cus";
