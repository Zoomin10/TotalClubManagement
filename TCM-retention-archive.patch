+      sub: "tester@wwfc.org.uk",
+      role: "membership_admin",
+      scope: "members",
+      method,
+      path: p,
+      bodyHash: crypto
+        .createHash("sha256")
+        .update(JSON.stringify(body || null))
+        .digest("hex"),
+      jti: crypto.randomUUID(),
+    },
+    process.env.TRUDASH_MEMBERSHIP_SHARED_SECRET,
+    {
+      algorithm: "HS256",
+      issuer: "trudash",
+      audience: "tcm-membership-admin",
+      expiresIn: 30,
+    },
+  );
+}
+async function run(access, fn) {
+  const { d, rows, log } = db();
+  const app = express();
+  app.use(express.json());
+  app.use("/api/admin", load("routes/admin.js", d, access));
+  const server = app.listen(0, "127.0.0.1");
+  await new Promise((r) => server.once("listening", r));
+  async function request(p, method = "GET", body) {
+    const route = "/api/admin" + p;
+    return fetch(`http://127.0.0.1:${server.address().port}${route}`, {
+      method,
+      headers: {
+        "x-trudash-assertion": token(method, route, body),
+        "Content-Type": "application/json",
+      },
+      ...(body ? { body: JSON.stringify(body) } : {}),
+    });
+  }
+  try {
+    await fn(request, rows, log);
+  } finally {
+    server.closeAllConnections();
+    await new Promise((r) => server.close(r));
+  }
+}
+const manager = {
