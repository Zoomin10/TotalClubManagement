diff --git a/tests/medicalPrivacy.test.cjs b/tests/medicalPrivacy.test.cjs
new file mode 100644
index 0000000..65e1d97
--- /dev/null
+++ b/tests/medicalPrivacy.test.cjs
@@ -0,0 +1,59 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const vm = require('node:vm');
+const fs = require('node:fs');
+const path = require('node:path');
+const express = require('../backend/node_modules/express');
+const jwt = require('../backend/node_modules/jsonwebtoken');
+const crypto = require('node:crypto');
+const { memberView, memberSelect } = require('../backend/src/services/memberView');
+const source=fs.readFileSync(path.join(__dirname,'../backend/src/routes/admin.js'),'utf8');
+const secret='test-only-bridge-secret-'.repeat(3);
+process.env.TRUDASH_MEMBERSHIP_SHARED_SECRET=secret;
+process.env.TRUDASH_ONLY_ADMIN_AUTH='true';
+const record={id:'member1',createdAt:new Date(),ageGroup:'u13',playerFirstName:'Player',playerSurname:'Example',medicalInfo:'ASTHMA_PRIVATE',allergies:'BEE_PRIVATE',invoices:[]};
+async function fixture(t,{exportAllowed=false,auditFails=false}={}) {
+ const audits=[];let queries=0;
+ const prisma={consentForm:{findMany:async()=>{queries++;return [record];},findUnique:async()=>record},reportExportAudit:{create:async args=>{if(auditFails)throw Error('audit unavailable');audits.push(args.data);}}};
+ const mod={exports:{}};
+ vm.runInNewContext(source,{module:mod,exports:mod.exports,process,console:{error(){}},Buffer,URL,Date,require(name){
+  if(name==='express')return express;
+  if(name==='jsonwebtoken')return jwt;
+  if(name==='csv-writer')return require('../backend/node_modules/csv-writer');
+  if(name==='../prisma')return prisma;
+  if(name==='../services/stripeService')return {createRegistrationCheckout:async()=> 'https://checkout.example',getStripe(){throw Error('not used');}};
+  if(name==='../services/invoiceService')return {};
+  if(name==='../services/memberView')return require('../backend/src/services/memberView');
+  if(name==='../middleware/trudashAdmin')return require('../backend/src/middleware/trudashAdmin');
+  throw Error(name);
+ }});
+ const app=express();app.use(express.json());app.use('/api/admin',mod.exports);
+ const server=await new Promise(resolve=>{const s=app.listen(0,'127.0.0.1',()=>resolve(s));});
+ t.after(()=>new Promise(resolve=>server.close(resolve)));
+ async function call(route,{signed=true,method='GET',permission=exportAllowed}={}){
+  const headers={};
+  if(signed)headers['x-trudash-assertion']=jwt.sign({sub:'admin@wwfc.org.uk',role:'membership_admin',fullCsvExport:permission,method,path:'/api/admin'+route,bodyHash:crypto.createHash('sha256').update('null').digest('hex'),jti:crypto.randomUUID()},secret,{algorithm:'HS256',issuer:'trudash',audience:'tcm-membership-admin',expiresIn:30});
+  return fetch(`http://127.0.0.1:${server.address().port}/api/admin${route}`,{method,headers});
+ }
+ return {call,audits,queries:()=>queries};
+}
+test('JSON projection excludes health and unrecognised future properties',()=>{
+ assert.equal(memberSelect.medicalInfo,undefined);assert.equal(memberSelect.allergies,undefined);
+ assert.equal(JSON.stringify(memberView({...record,newHealthField:'secret'})).includes('PRIVATE'),false);
+ assert.equal(memberView({...record,newHealthField:'secret'}).newHealthField,undefined);
+});
+test('members, legacy registrations and resumed setup responses contain no medical values',async t=>{
+ const f=await fixture(t);
+ for(const [route,method] of [['/members','GET'],['/registrations','GET'],['/registrations/member1/payment-setup','POST']]){
+  const r=await f.call(route,{method});assert.equal(r.status,200);const body=await r.text();assert.equal(body.includes('PRIVATE'),false);assert.equal(body.includes('medicalInfo'),false);assert.equal(body.includes('allergies'),false);
+ }
+});
+test('ordinary admins and unsigned requests cannot query or export full records',async t=>{
+ const f=await fixture(t);assert.equal((await f.call('/registrations.csv')).status,403);assert.equal((await f.call('/registrations.csv',{signed:false})).status,401);assert.equal(f.queries(),0);assert.equal(f.audits.length,0);
+});
+test('authorised full CSV retains declarations and records actor without health values',async t=>{
+ const f=await fixture(t,{exportAllowed:true});const r=await f.call('/registrations.csv');assert.equal(r.status,200);assert.equal(r.headers.get('cache-control'),'no-store');const csv=await r.text();assert.ok(csv.includes('ASTHMA_PRIVATE'));assert.ok(csv.includes('BEE_PRIVATE'));assert.equal(f.audits.length,1);assert.equal(f.audits[0].actor,'admin@wwfc.org.uk');assert.equal(f.audits[0].recordCount,1);assert.equal(JSON.stringify(f.audits).includes('PRIVATE'),false);
+});
+test('audit failure prevents release of a full CSV',async t=>{
+ const f=await fixture(t,{exportAllowed:true,auditFails:true});const r=await f.call('/registrations.csv');assert.equal(r.status,500);assert.equal((await r.text()).includes('PRIVATE'),false);
+});
