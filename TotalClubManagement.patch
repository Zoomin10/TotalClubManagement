diff --git a/backend/src/services/retentionReview.js b/backend/src/services/retentionReview.js
new file mode 100644
index 0000000..f1318af
--- /dev/null
+++ b/backend/src/services/retentionReview.js
@@ -0,0 +1,38 @@
+const {DateTime}=require('luxon');
+const zone='Europe/London';
+function reviewRecord(record,now=new Date()){
+ const registered=DateTime.fromJSDate(new Date(record.createdAt),{zone});
+ const today=DateTime.fromJSDate(new Date(now),{zone});
+ const valid=registered.isValid&&registered.toMillis()<=today.toMillis();
+ const startYear=valid?(registered.month>=6?registered.year:registered.year-1):null;
+ const end=valid?DateTime.fromObject({year:startYear+1,month:5,day:31},{zone}).endOf('day'):null;
+ const proposedReview=end?.plus({years:1});
+ const state=!valid?'CHECK_REGISTRATION_DATE':today.toMillis()<=end.toMillis()?'CURRENT_INFERRED_SEASON':today.toMillis()<=proposedReview.toMillis()?'REVIEW_RENEWAL':'REVIEW_OLD_REGISTRATION';
+ return {
+  id:record.id,playerFirstName:record.playerFirstName,playerSurname:record.playerSurname,
+  team:record.wwfcTeam||null,registeredAt:record.createdAt,
+  inferredSeason:startYear===null?null:`${startYear}/${String(startYear+1).slice(-2)}`,
+  seasonEnd:end?.toISODate()||null,
+  proposedArchiveReviewDate:proposedReview?.toISODate()||null,
+  state,seasonBasis:'REGISTRATION_DATE_ONLY',renewalStatus:'UNCONFIRMED',
+  billingReviewRequired:Boolean(record.stripeScheduleId||record.stripeSubscriptionId||record.stripeSubscriptionStatus),
+  openInvoiceCount:record._count?.invoices||0,
+  deletionEligible:false,
+ };
+}
+async function retentionReview(prisma,now=new Date()){
+ const records=await prisma.consentForm.findMany({
+  select:{id:true,createdAt:true,playerFirstName:true,playerSurname:true,wwfcTeam:true,
+   stripeScheduleId:true,stripeSubscriptionId:true,stripeSubscriptionStatus:true,
+   _count:{select:{invoices:{where:{status:'open',amountRemainingPence:{gt:0}}}}}},
+  orderBy:{createdAt:'asc'},
+ });
+ const members=records.map(record=>reviewRecord(record,now));
+ const counts={total:members.length,currentInferredSeason:0,reviewRenewal:0,reviewOldRegistration:0,checkRegistrationDate:0};
+ for(const member of members){const key={CURRENT_INFERRED_SEASON:'currentInferredSeason',REVIEW_RENEWAL:'reviewRenewal',REVIEW_OLD_REGISTRATION:'reviewOldRegistration',CHECK_REGISTRATION_DATE:'checkRegistrationDate'}[member.state];counts[key]++;}
+ return {generatedAt:new Date(now).toISOString(),timeZone:zone,seasonEnd:'31 May',proposedArchiveMonths:12,
+  destructiveActionsEnabled:false,
+  notice:'Read-only review. Seasons are inferred from registration dates. Renewal, departure, archive dates and record holds are not recorded. Confirm these separately before deciding what to retain or remove. The 12-month archive period is a proposal.',
+  counts,members};
+}
+module.exports={reviewRecord,retentionReview};
diff --git a/tests/retentionReview.test.cjs b/tests/retentionReview.test.cjs
new file mode 100644
index 0000000..b409a0a
--- /dev/null
+++ b/tests/retentionReview.test.cjs
@@ -0,0 +1,52 @@
+const test=require('node:test');const assert=require('node:assert/strict');
+const {reviewRecord,retentionReview}=require('../backend/src/services/retentionReview');
+const seed={id:'m1',createdAt:new Date('2026-10-14T10:00:00Z'),playerFirstName:'Example',playerSurname:'Player',wwfcTeam:'U13',medicalInfo:'HEALTH_PRIVATE',allergies:'ALLERGY_PRIVATE',email:'CONTACT_PRIVATE',playerDob:'2013-01-01',stripeSubscriptionId:'sub_private',_count:{invoices:2}};
+test('October registration maps to the following May with a proposed 12-month review',()=>{
+ const row=reviewRecord(seed,new Date('2026-10-14T12:00:00Z'));assert.equal(row.inferredSeason,'2026/27');assert.equal(row.seasonEnd,'2027-05-31');assert.equal(row.proposedArchiveReviewDate,'2028-05-31');assert.equal(row.state,'CURRENT_INFERRED_SEASON');assert.equal(row.deletionEligible,false);assert.equal(row.renewalStatus,'UNCONFIRMED');
+});
+test('season boundaries use London dates including summer time',()=>{
+ const before=reviewRecord({...seed,createdAt:new Date('2026-05-31T22:59:59.999Z')},new Date('2026-06-01T12:00:00Z'));
+ const after=reviewRecord({...seed,createdAt:new Date('2026-05-31T23:00:00Z')},new Date('2026-06-01T12:00:00Z'));
+ assert.equal(before.inferredSeason,'2025/26');assert.equal(after.inferredSeason,'2026/27');
+ assert.equal(reviewRecord(seed,new Date('2027-05-31T22:59:59.999Z')).state,'CURRENT_INFERRED_SEASON');
+ assert.equal(reviewRecord(seed,new Date('2027-05-31T23:00:00Z')).state,'REVIEW_RENEWAL');
+ assert.equal(reviewRecord(seed,new Date('2028-05-31T23:00:00Z')).state,'REVIEW_OLD_REGISTRATION');
+});
+test('old, future or invalid registrations never become deletion eligible',()=>{
+ for(const createdAt of ['2020-01-01','2030-01-01','not-a-date']){
+ const row=reviewRecord({...seed,createdAt},new Date('2026-10-14'));assert.equal(row.deletionEligible,false);assert.equal(row.renewalStatus,'UNCONFIRMED');
+ if(createdAt!=='2020-01-01')assert.equal(row.state,'CHECK_REGISTRATION_DATE');
+ }
+});
+test('report explicitly selects minimal fields and never returns health, contact or Stripe identifiers',async()=>{
+ let calls=0;const prisma={consentForm:{findMany:async args=>{calls++;assert.equal(args.select.medicalInfo,undefined);assert.equal(args.select.email,undefined);return [seed];}}};
+ const report=await retentionReview(prisma,new Date('2026-10-14T12:00:00Z'));assert.equal(calls,1);assert.equal(report.destructiveActionsEnabled,false);assert.equal(report.counts.currentInferredSeason,1);assert.equal(report.members[0].billingReviewRequired,true);assert.equal(report.members[0].openInvoiceCount,2);
+ const json=JSON.stringify(report);assert.equal(json.includes('PRIVATE'),false);assert.equal(json.includes('sub_private'),false);assert.equal(json.includes('medicalInfo'),false);
+});
+const vm=require('node:vm'),fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
+const express=require('../backend/node_modules/express'),jwt=require('../backend/node_modules/jsonwebtoken');
+const secret='retention-test-only-secret-'.repeat(3);process.env.TRUDASH_MEMBERSHIP_SHARED_SECRET=secret;
+async function fixture(t){
+ let reads=0;const prisma={consentForm:{findMany:async()=>{reads++;return [seed];}}};
+ const mod={exports:{}};
+ vm.runInNewContext(fs.readFileSync(path.join(__dirname,'../backend/src/routes/admin.js'),'utf8'),{module:mod,process,console:{error(){}},URL,Buffer,Date,require(name){
+ if(name==='express')return express;if(name==='csv-writer')return require('../backend/node_modules/csv-writer');if(name==='../prisma')return prisma;
+ if(name==='../services/applicationPermissions')return {applicationAccess:async identity=>({permissions:identity.username!=='superonly@wwfc.org.uk'?['MEMBERS_MANAGE']:[],superAdmin:['chair@wwfc.org.uk','superonly@wwfc.org.uk'].includes(identity.username)})};
+ if(name==='../services/retentionReview')return {retentionReview};
+ if(name==='../middleware/trudashAdmin')return require('../backend/src/middleware/trudashAdmin');
+ if(name==='../services/memberView')return require('../backend/src/services/memberView');return {};
+ }});
+ const app=express();app.use(express.json());app.use('/api/admin',mod.exports);
+ const server=await new Promise(resolve=>{const s=app.listen(0,'127.0.0.1',()=>resolve(s));});t.after(()=>new Promise(resolve=>server.close(resolve)));
+ async function call(username,method='GET'){
+ const route='/api/admin/retention-review';const headers={};if(username)headers['x-trudash-assertion']=jwt.sign({sub:username,role:'membership_admin',scope:'members',method,path:route,bodyHash:crypto.createHash('sha256').update('null').digest('hex'),jti:crypto.randomUUID()},secret,{issuer:'trudash',audience:'tcm-membership-admin',expiresIn:30});
+ return fetch(`http://127.0.0.1:${server.address().port}${route}`,{method,headers});
+ }
+ return {call,reads:()=>reads};
+}
+test('ordinary member administrators and Super Admin without membership permission cannot query the report',async t=>{
+ const f=await fixture(t);assert.equal((await f.call()).status,401);assert.equal((await f.call('memberadmin@wwfc.org.uk')).status,403);assert.equal((await f.call('superonly@wwfc.org.uk')).status,403);assert.equal(f.reads(),0);
+});
+test('eligible Super Admin can read the report; no destructive endpoint exists',async t=>{
+ const f=await fixture(t);const response=await f.call('chair@wwfc.org.uk');assert.equal(response.status,200);assert.equal(response.headers.get('cache-control'),'no-store');assert.equal((await response.json()).destructiveActionsEnabled,false);assert.equal(f.reads(),1);assert.equal((await f.call('chair@wwfc.org.uk','POST')).status,404);assert.equal(f.reads(),1);
+});
