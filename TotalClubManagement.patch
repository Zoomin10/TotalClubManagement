+ for(const record of [{status:'INACTIVE',accessRole:'SUPER_ADMIN',applicationPermissions:['MEMBERS_MANAGE']},{status:'ACTIVE',missing:['COACH'],accessRole:'SUPER_ADMIN',applicationPermissions:['FINANCE_DETAILS']}])assert.equal((await access(record)({username:'x'})).permissions.length,0);
+});
+const importer=fs.readFileSync(path.join(__dirname,'../backend/scripts/import-application-permissions.cjs'),'utf8');
+async function runImport({apply=false,eligible=true}={}){
+ const updates=[],audits=[],errors=[];let disconnected;
+ const finished=new Promise(resolve=>disconnected=resolve);
+ const record={id:'v1',status:eligible?'ACTIVE':'INACTIVE',applicationPermissions:[],acceptances:[]};
+ const db={clubVolunteer:{findUnique:async()=>record,update:async x=>updates.push(x)},volunteerChange:{create:async x=>audits.push(x)},$disconnect:async()=>disconnected()};db.$transaction=async fn=>fn(db);
+ const processStub={argv:['node','script','manifest.json',...(apply?['--apply']:[])],exitCode:0};
+ vm.runInNewContext(importer,{require:name=>name==='dotenv'?{config(){}}:name==='node:fs'?{readFileSync:()=>JSON.stringify({grants:[{email:'person@wwfc.org.uk',permissions:['FINANCE_DETAILS']}]})}:name.includes('volunteerService')?{prisma:db,currentAcceptances:()=>[]}: {permissionOptions:[{key:'FINANCE_DETAILS'}]},process:processStub,console:{log(){},error:x=>errors.push(x)}});
+ await finished;return {updates,audits,errors,code:processStub.exitCode};
+}
+test('legacy importer is read-only by default and audits explicit apply',async()=>{
+ const dry=await runImport();assert.equal(dry.updates.length,0);assert.equal(dry.audits.length,0);
+ const applied=await runImport({apply:true});assert.equal(applied.updates.length,1);assert.equal(applied.audits[0].data.action,'PERMISSIONS_IMPORTED');assert.equal(applied.code,0);
+ const blocked=await runImport({apply:true,eligible:false});assert.equal(blocked.updates.length,0);assert.equal(blocked.code,1);
+});
