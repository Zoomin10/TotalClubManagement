+const test=require('node:test');const assert=require('node:assert/strict');const vm=require('node:vm');const fs=require('node:fs');const path=require('node:path');
+const source=fs.readFileSync(path.join(__dirname,'../backend/src/services/applicationPermissions.js'),'utf8');
+function access(record){const mod={exports:{}};vm.runInNewContext(source,{module:mod,require:()=>({prisma:{clubVolunteer:{findUnique:async()=>record}},currentAcceptances:v=>v.missing||[]})});return mod.exports.applicationAccess;}
+test('active accepted permissions are explicit, filtered and independent of club titles',async()=>{
+ const read=access({status:'ACTIVE',accessRole:'NONE',assignedRoles:['Trustee','Treasurer'],applicationPermissions:['FINANCE_DETAILS','FULL_CSV_EXPORT','UNKNOWN']});
+ const out=await read({username:'person@wwfc.org.uk'});assert.deepEqual(Array.from(out.permissions),['FINANCE_DETAILS','FULL_CSV_EXPORT']);assert.equal(out.superAdmin,false);
+ const none=await access({status:'ACTIVE',accessRole:'ADMIN',applicationPermissions:[]})({username:'x'});assert.equal(none.permissions.length,0);
+});
+test('bootstrap recovers volunteer management but does not implicitly grant finance or CSV',async()=>{
+ for(const record of [null,{status:'INACTIVE',accessRole:'SUPER_ADMIN',applicationPermissions:['FULL_CSV_EXPORT']},{status:'ACTIVE',missing:['VOLUNTEER'],applicationPermissions:['FINANCE_DETAILS']}]){
+ const result=await access(record)({username:'recovery',volunteerSuperAdmin:true});assert.deepEqual(Array.from(result.permissions),['VOLUNTEERS_MANAGE']);assert.equal(result.superAdmin,true);
+ }
+ const valid=await access({status:'ACTIVE',accessRole:'NONE',applicationPermissions:['MEMBERS_MANAGE']})({username:'recovery',volunteerSuperAdmin:true});assert.ok(valid.permissions.includes('MEMBERS_MANAGE'));assert.ok(valid.permissions.includes('VOLUNTEERS_MANAGE'));
+});
