diff --git a/backend/src/routes/socialMedia.js b/backend/src/routes/socialMedia.js
new file mode 100644
index 0000000..335d330
--- /dev/null
+++ b/backend/src/routes/socialMedia.js
@@ -0,0 +1,34 @@
+const express = require("express");
+const { z } = require("zod");
+const prisma = require("../prisma");
+const { verifyTrudashAdmin } = require("../middleware/trudashAdmin");
+const { normalisePostUrl } = require("../services/socialMediaService");
+const router = express.Router();
+router.use((req, res, next) => {
+  res.set("Cache-Control", "no-store");
+  if (!req.get("x-trudash-assertion")) return res.status(401).json({ error: "Sign in through TruDash" });
+  if (verifyTrudashAdmin(req, res)) next();
+});
+router.get("/", async (req, res) => {
+  try {
+    const posts = await prisma.socialMediaPost.findMany({ orderBy: { createdAt: "desc" } });
+    res.json({ posts });
+  } catch { res.status(500).json({ error: "Social media posts could not be loaded." }); }
+});
+router.post("/", async (req, res) => {
+  const parsed = z.object({ url: z.string().trim().min(1).max(2000), title: z.string().trim().max(150).default("") }).safeParse(req.body);
+  if (!parsed.success) return res.status(400).json({ error: "Please check the post URL and title." });
+  let details;
+  try { details = normalisePostUrl(parsed.data.url); }
+  catch (error) { return res.status(400).json({ error: error.message }); }
+  try {
+    const post = await prisma.socialMediaPost.upsert({ where: { url: details.url }, update: {}, create: { ...details, title: parsed.data.title, createdBy: req.trudashAdmin.username } });
+    res.json(post);
+  } catch { res.status(500).json({ error: "The post link could not be saved." }); }
+});
+router.delete("/:id", async (req, res) => {
+  if (req.body?.confirm !== true) return res.status(400).json({ error: "Removal confirmation is required." });
+  try { await prisma.socialMediaPost.delete({ where: { id: req.params.id } }); res.json({ success: true }); }
+  catch (error) { res.status(error.code === "P2025" ? 404 : 500).json({ error: error.code === "P2025" ? "Post link not found." : "The post link could not be removed." }); }
+});
+module.exports = router;
diff --git a/backend/src/services/socialMediaService.js b/backend/src/services/socialMediaService.js
new file mode 100644
index 0000000..8f2023f
--- /dev/null
+++ b/backend/src/services/socialMediaService.js
@@ -0,0 +1,18 @@
+function normalisePostUrl(value) {
+  let url;
+  try { url = new URL(value); } catch { throw new Error("Please enter a full Facebook or Instagram post URL."); }
+  if (url.protocol !== "https:" || url.username || url.password) throw new Error("Please use a public HTTPS post URL.");
+  const host = url.hostname.toLowerCase();
+  if (["www.instagram.com", "instagram.com"].includes(host) && /^\/(p|reel)\/[A-Za-z0-9_-]+\/?$/.test(url.pathname)) {
+    return { platform: "INSTAGRAM", url: `https://www.instagram.com${url.pathname.replace(/\/$/, "")}/` };
+  }
+  if (["www.facebook.com", "facebook.com", "m.facebook.com"].includes(host)) {
+    if (/^\/WroughtonYFC\/posts\/[A-Za-z0-9_-]+\/?$/i.test(url.pathname)) {
+      const id = url.pathname.split("/")[3];
+      return { platform: "FACEBOOK", url: `https://www.facebook.com/WroughtonYFC/posts/${id}/` };
+    }
+    if (/^\/reel\/\d+\/?$/.test(url.pathname)) return { platform: "FACEBOOK", url: `https://www.facebook.com${url.pathname.replace(/\/$/, "")}/` };
+  }
+  throw new Error("Use a Facebook post from WroughtonYFC, a Facebook reel, or an Instagram post/reel permalink. Profile and shortened share links are not supported.");
+}
+module.exports = { normalisePostUrl };
